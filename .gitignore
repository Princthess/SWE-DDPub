# renv: ignore the installed library, keep the lockfile
renv/library/
renv/local/
renv/cellar/
renv/staging/

# R session artefacts
.Rhistory
.RData
.Rproj.user/

# Private/personal notes — never publish
noobreadme.md
CONTEXT.md

# Data: keep the folder structure, ignore the actual PDFs, text, results,
# caches, and archived runs (your corpus and outputs stay local).
data/pdfs/*
!data/pdfs/.gitkeep
data/*.csv
data/*.txt
data/*.rds
data/archive/
*.pdf
