# renv: ignore the installed library, keep the lockfile
renv/library/
renv/local/
renv/cellar/
renv/staging/

# R session artefacts
.Rhistory
.RData
.Rproj.user/

# Private/personal notes — never publish
noobreadme.md
CONTEXT.md

# Data: keep the folder structure, ignore the actual PDFs, text, and results
data/pdfs/*
!data/pdfs/.gitkeep
data/*.csv
data/*.txt
*.pdf
